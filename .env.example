# Environment example for QuantumPanda WHMCS Basic Integration
# Copy to .env.local and fill in secrets for local development

# WHMCS admin API credentials (server-only)
WHMCS_API_URL=https://billing.example.com/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
# Base client area URL used for SSO redirect validation
WHMCS_BASE_URL=https://billing.example.com

# Session signing
APP_SESSION_SECRET=change-me-to-a-long-random-string

# Feature flags (public)
NEXT_PUBLIC_FEATURE_WHMCS_BASIC=true
NEXT_PUBLIC_APP_URL=https://bluepandahosting.in
NEXT_PUBLIC_LEGACY_APP_URL=https://qpanda.bluepanda.cloud
NEXT_PUBLIC_BLUEPANDA_URL=https://www.bluepanda.in
NEXT_PUBLIC_BLUEPANDA_CONSULTATION_URL=https://www.bluepanda.in/#contact
NEXT_PUBLIC_WHMCS_CLIENT_AREA_URL=https://billing.example.com/clientarea.php
NEXT_PUBLIC_WHMCS_SUPPORT_URL=https://billing.example.com/submitticket.php

# Runtime mode
ENABLE_WHMCS_INTEGRATION=true

# Optional: use mocked WHMCS responses for local development without live credentials
USE_MOCK_WHMCS=true
